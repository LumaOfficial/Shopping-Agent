{
  "manifest_version": 3,
  "name": "Shopping-Agent Savings",
  "version": "0.5.0",
  "description": "Finds coupon codes, cashback offers and price history from Partner Platforms while you shop. Never reads card details.",
  "icons": {
    "16": "icons/luma-pay-16.png",
    "32": "icons/luma-pay-32.png",
    "48": "icons/luma-pay-48.png",
    "128": "icons/luma-pay-128.png"
  },
  "minimum_chrome_version": "116",
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; media-src 'self' data: blob:; connect-src *"
  },
  "permissions": [
    "storage",
    "tabs",
    "sidePanel",
    "scripting",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://api.keepa.com/*",
    "*://*/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ads",
        "enabled": true,
        "path": "rules/ads.json"
      }
    ]
  },
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open savings",
    "default_icon": {
      "16": "icons/luma-pay-16.png",
      "32": "icons/luma-pay-32.png",
      "48": "icons/luma-pay-48.png"
    }
  },
  "commands": {
    "open-panel": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "Open the Savings side panel"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["*://*/*"],
      "js": ["src/content/ad-guard.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
