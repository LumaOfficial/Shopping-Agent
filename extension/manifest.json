{
  "manifest_version": 3,
  "name": "Shopping-Agent Savings",
  "version": "0.3.0",
  "description": "Finds coupon codes, cashback offers and price history from Partner Platforms while you shop. Never reads card details.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "tabs", "sidePanel"],
  "host_permissions": [
    "https://api.keepa.com/*",
    "https://api.linksynergy.com/*"
  ],
  "optional_host_permissions": ["https://*/*"],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open savings"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "*://*.amazon.com/*",
        "*://*.ebay.com/*",
        "*://*.etsy.com/*",
        "*://*.aliexpress.com/*",
        "*://*.temu.com/*",
        "*://*.target.com/*",
        "*://*.walmart.com/*",
        "*://*.kohls.com/*",
        "*://*.jcpenney.com/*",
        "*://*.costco.com/*",
        "*://*.samsclub.com/*",
        "*://*.bestbuy.com/*",
        "*://*.newegg.com/*",
        "*://*.bhphotovideo.com/*",
        "*://*.microcenter.com/*",
        "*://*.gamestop.com/*",
        "*://*.apple.com/*",
        "*://*.samsung.com/*",
        "*://*.dell.com/*",
        "*://*.hp.com/*",
        "*://*.lenovo.com/*",
        "*://*.logitech.com/*",
        "*://*.homedepot.com/*",
        "*://*.lowes.com/*",
        "*://*.wayfair.com/*",
        "*://*.ikea.com/*",
        "*://*.westelm.com/*",
        "*://*.potterybarn.com/*",
        "*://*.williams-sonoma.com/*",
        "*://*.crateandbarrel.com/*",
        "*://*.bedbathandbeyond.com/*",
        "*://*.overstock.com/*",
        "*://*.houzz.com/*",
        "*://*.dyson.com/*",
        "*://*.nespresso.com/*",
        "*://*.ashleyfurniture.com/*",
        "*://*.macys.com/*",
        "*://*.nordstrom.com/*",
        "*://*.nordstromrack.com/*",
        "*://*.bloomingdales.com/*",
        "*://*.saks.com/*",
        "*://*.neimanmarcus.com/*",
        "*://*.nike.com/*",
        "*://*.adidas.com/*",
        "*://*.lululemon.com/*",
        "*://*.underarmour.com/*",
        "*://*.footlocker.com/*",
        "*://*.gap.com/*",
        "*://*.oldnavy.com/*",
        "*://*.bananarepublic.com/*",
        "*://*.hm.com/*",
        "*://*.zara.com/*",
        "*://*.uniqlo.com/*",
        "*://*.asos.com/*",
        "*://*.shein.com/*",
        "*://*.urbanoutfitters.com/*",
        "*://*.anthropologie.com/*",
        "*://*.freepeople.com/*",
        "*://*.ae.com/*",
        "*://*.abercrombie.com/*",
        "*://*.sephora.com/*",
        "*://*.ulta.com/*",
        "*://*.glossier.com/*",
        "*://*.bathandbodyworks.com/*",
        "*://*.chewy.com/*",
        "*://*.petco.com/*",
        "*://*.petsmart.com/*",
        "*://*.rei.com/*",
        "*://*.dickssportinggoods.com/*",
        "*://*.onepeloton.com/*",
        "*://*.kroger.com/*",
        "*://*.instacart.com/*",
        "*://*.walgreens.com/*",
        "*://*.cvs.com/*",
        "*://*.staples.com/*",
        "*://*.officedepot.com/*",
        "*://*.expedia.com/*",
        "*://*.booking.com/*",
        "*://*.hotels.com/*",
        "*://*.doordash.com/*",
        "*://*.grubhub.com/*",
        "*://*.ubereats.com/*"
      ],
      "js": ["src/lib/coupon-engine.js", "src/content/content.js"],
      "run_at": "document_idle"
    }
  ]
}
